{
  "name": "seyl-ai",
  "version": "1.0.0",
  "private": true,
  "description": "My own AI agent.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n harness,server,web -c magenta,blue,green \"npm:dev:harness\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:harness": "tsx server/harness.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@opencode-ai/sdk": "^1.18.33",
    "hono": "^4.13.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
