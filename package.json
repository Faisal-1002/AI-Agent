{
  "name": "seyl-ai",
  "version": "1.0.0",
  "private": true,
  "description": "My own AI agent.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n harness,server,web -c magenta,blue,green \"npm:dev:harness\" \"npm:dev:server\" \"npm:dev:web\"",
    "dev:harness": "tsx server/harness.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "typecheck": "tsc",
    "build": "vite build",
    "gateway:keys": "tsx scripts/gateway-keys.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@opencode-ai/sdk": "^1.18.33",
    "clsx": "^2.1.1",
    "hono": "^4.13.11",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "highlight.js": "^11.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
