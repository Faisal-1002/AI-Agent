# Copy to .env and fill in long random values (e.g. `openssl rand -hex 24`).
# .env is git-ignored. Docker Compose reads it directly; Kubernetes gets it as a
# Secret through kustomization.yaml (`kubectl apply -k .`).

# LiteLLM gateway: admin/root key (also the admin UI password) and the key that encrypts stored credentials
LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=sk-change-me

# Postgres (LiteLLM stores keys + usage here)
POSTGRES_PASSWORD=change-me

# Per-consumer gateway keys (least privilege: each can only use its own models).
# Registered in LiteLLM by `npm run gateway:keys`.
LITELLM_KEY_HARNESS=sk-harness-change-me
LITELLM_KEY_API=sk-api-change-me
